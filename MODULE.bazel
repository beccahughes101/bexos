# Early boot hashes the complete BootFS in BL33 and again in the kernel. Keep
# block compression optimized in default builds as well as opt builds so these
# mandatory authentication checks fit within the developer readiness timeout.
crate.annotation_select(
    crate = "sha2",
    version = "0.10.9",
    triples = ["aarch64-unknown-none"],
    rustc_flags = ["-C", "opt-level=3"],
)

# The bare-metal x86 ABI disables SIMD; select scalar crypto implementations.
crate.annotation_select(
    crate = "sha2",
    version = "0.10.9",
    triples = ["x86_64-unknown-none"],
    crate_features = ["force-soft"],
)
crate.annotation_select(
    crate = "sha2",
    version = "0.11.0",
    triples = ["x86_64-unknown-none"],
    rustc_flags = ["--cfg", "sha2_backend=\"soft\""],
)
crate.annotation_select(
    crate = "curve25519-dalek",
    triples = ["x86_64-unknown-none"],
    rustc_flags = ["--cfg", "curve25519_dalek_backend=\"serial\""],
    build_script_env = {"CARGO_CFG_CURVE25519_DALEK_BACKEND": "serial"},
)

