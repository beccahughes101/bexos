package_name: "bexos.service.pkgd"
name: "Package Resolver rejection fixture"
processes {
  name: "pkgd"
  runner: "elf"
  service: true
  lifecycle { update_strategy: HEART_TRANSPLANT preparation_timeout_ms: 2000 }
  runner_options { [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/pkgd" } }
}
