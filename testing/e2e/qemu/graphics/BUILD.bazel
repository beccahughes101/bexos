sh_test(
    name = "boot_ui_test",
    srcs = ["test.sh"],
    env = guest_select(dict({
        "BOOT_UI_PROBE": "$(rootpath :transplant_probe)",
        "BOOT_UI_SCRIPT": "$(rootpath boot_ui_test.py)",
        "BOOT_UI_BOOTFS": "$(rootpath //device/virtual/qemu/workstation:bootfs.emulated.img)",
        "BOOT_UI_HANDOFF": "$(rootpath //device/virtual/qemu/workstation:boot_handoff.emulated.bin)",
        "BOOT_UI_EVIDENCE": "$(rootpath //device/virtual/qemu/workstation:boot_evidence.emulated.bin)",
        "BOOT_UI_DISK": "$(rootpath //device/virtual/qemu/workstation:qemu_nvme_development_gpt.img)",
        "BOOT_UI_ARCH": "aarch64",
        "BOOT_UI_KERNEL": "$(rootpath //kernel:kernel)",
    }.items() + TRANSPLANT_ARCHIVE_ENV.items()), dict({
        "BOOT_UI_PROBE": "$(rootpath :transplant_probe)",
        "BOOT_UI_SCRIPT": "$(rootpath boot_ui_test.py)",
        "BOOT_UI_BOOTFS": "$(rootpath //device/virtual/qemu/workstation:bootfs.emulated.img)",
        "BOOT_UI_HANDOFF": "$(rootpath //device/virtual/qemu/workstation:boot_handoff.emulated.bin)",
        "BOOT_UI_EVIDENCE": "$(rootpath //device/virtual/qemu/workstation:boot_evidence.emulated.bin)",
        "BOOT_UI_DISK": "$(rootpath //device/virtual/qemu/workstation:qemu_nvme_development_gpt.img)",
        "BOOT_UI_ARCH": "x86_64",
        "BOOT_UI_KERNEL": "$(rootpath //device/virtual/qemu/workstation:x86_64_boot_image)",
    }.items() + TRANSPLANT_ARCHIVE_ENV.items())),
    data = [":transplant_probe", "boot_ui_test.py", "//testing/performance/scened:guest.py", "input_hotplug.py", "//device/virtual/qemu/workstation:bootfs.emulated.img", "//device/virtual/qemu/workstation:boot_handoff.emulated.bin", "//device/virtual/qemu/workstation:boot_evidence.emulated.bin", "//device/virtual/qemu/workstation:qemu_nvme_development_gpt.img"] + guest_select(["//kernel:kernel"], ["//device/virtual/qemu/workstation:x86_64_boot_image"]) + TRANSPLANT_ARCHIVE_DATA,
    tags = QEMU_GRAPHICS_TAGS + ["e2e-tier-extended"],
    timeout = "long",
)
architecture_test(scened_standalone = True, name = "boot_ui_aarch64", architecture = "aarch64", test = ":boot_ui_test", tags = QEMU_GRAPHICS_TAGS + ["e2e-tier-extended", "qemu-integrated"], timeout = "long")
architecture_test(scened_standalone = True, name = "boot_ui_x86_64", architecture = "x86_64", test = ":boot_ui_test", tags = QEMU_GRAPHICS_TAGS + ["e2e-tier-extended", "qemu-integrated"], timeout = "long")

