load("//testing/e2e/qemu:architecture_test.bzl", "qemu_suites")
load("//testing/e2e/qemu:qemu_e2e.bzl", "QEMU_BOOT_ARTIFACTS", "qemu_e2e_test")

package(default_visibility = ["//visibility:public"])

SDK_NIC_QEMU_ARGS = [
    "-netdev",
    "user,id=sdke1000e",
    "-device",
    "e1000e,bus=pcie.0,addr=a,netdev=sdke1000e,mac=52:54:00:12:34:59,romfile=",
]

SDK_BOOT_ARTIFACTS = dict(QEMU_BOOT_ARTIFACTS)
SDK_BOOT_ARTIFACTS.update({
    "disk": "//device/virtual/qemu/sdk_acceptance:qemu_nvme_gpt.img",
    "bootfs": "//device/virtual/qemu/sdk_acceptance:bootfs.img",
    "handoff": "//device/virtual/qemu/sdk_acceptance:boot_handoff.bin",
    "evidence": "//device/virtual/qemu/sdk_acceptance:boot_evidence.bin",
    "vbmeta": "//device/virtual/qemu/sdk_acceptance:vbmeta.img",
    "avb_public_key": "//device/virtual/qemu/sdk_acceptance:avb_dev_public_key.bin",
    "layout": "//device/virtual/qemu/sdk_acceptance:boot_layout.sh",
})

qemu_e2e_test(
    name = "sdk_acceptance",
    tier = "extended",
    src = "sdk_acceptance.rs",
    crate_name = "bexos_sdk_acceptance",
    deps = ["//host/debug_client", "//testing/e2e", "//tools/qemu:qemu_test"],
    boot_data = SDK_BOOT_ARTIFACTS,
    qemu_args = SDK_NIC_QEMU_ARGS,
    # Integrated x86 boots hand the monitor an ELF kernel, so select the
    # product-local metadata signed over that ELF rather than the flat-kernel
    # metadata used by the AArch64 handoff path.
    x86_extra_data = [
        "//device/virtual/qemu/sdk_acceptance:avb_dev_public_key.elf.bin",
        "//device/virtual/qemu/sdk_acceptance:vbmeta.elf.img",
    ],
    x86_env_overrides = {
        "BEXOS_QEMU_AVB_PUBLIC_KEY": "$(rootpath //device/virtual/qemu/sdk_acceptance:avb_dev_public_key.elf.bin)",
        # The x86 integrated guest runs under software TCG on the supported
        # macOS host.  Instantiating the first WASM service can legitimately
        # leave the named boot milestones unchanged for more than the generic
        # two-minute stall window, even though native relocation, Trusty, and
        # encrypted-storage startup are still making serial progress. Keep the
        # acceptance bounded while allowing the measured software-emulation path.
        "BEXOS_QEMU_STALL_TIMEOUT_SECONDS": "1800",
        "BEXOS_QEMU_TIMEOUT_SECONDS": "5400",
        "BEXOS_QEMU_VBMETA": "$(rootpath //device/virtual/qemu/sdk_acceptance:vbmeta.elf.img)",
    },
)

qemu_suites()
