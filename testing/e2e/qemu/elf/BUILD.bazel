load("@rules_cc//cc:defs.bzl", "cc_library")
load("//build/platforms:architecture.bzl", "guest_select")
load("//build/rules:userspace.bzl", "app_manifest", "std_shared_library", "std_service_binary")
load("//build/rules:app_archive.bzl", "app_archive")
load("//testing/e2e/qemu:qemu_e2e.bzl", "qemu_e2e_test", "qemu_development_e2e_test", "QEMU_BOOT_DATA", "QEMU_DEVELOPMENT_BOOT_DATA")
load("//testing/e2e/qemu:architecture_test.bzl", "qemu_suites")
package(default_visibility = ["//visibility:public"])
cc_library(
    name = "tls_fixture", srcs = ["fixture.c"], alwayslink = True,
    copts = ["-fPIC"] + guest_select(["-ftls-model=initial-exec"], ["-ftls-model=global-dynamic"]),
)
std_shared_library(
    name = "library", srcs = ["library.rs"], crate_root = "library.rs", crate_name = "elf_fixture",
    soname = "libbexos_elf_fixture.so", deps = [":tls_fixture"],
)
std_service_binary(name = "probe", srcs = ["probe.rs", "network.rs", "keychain.rs"] + glob(["arch/*.rs"]), crate_name = "elf_probe", deps = ["//lib/net:net_secure", "//idl:app_service_directory_fidl_rust", "//idl:net_fidl_rust", "//idl:keychain_fidl_rust"])
app_manifest(name = "library_manifest", src = "library.prototxt")
app_manifest(name = "probe_manifest", src = "probe.prototxt")
app_archive(name = "library_archive", manifest = ":library_manifest", entries = {"lib/libbexos_elf_fixture.so": ":library"}, compression = "zstd")
app_archive(name = "probe_archive", manifest = ":probe_manifest", entries = {"bin/elf_probe": ":probe"}, compression = "zstd")
qemu_development_e2e_test(
    name = "elf_development_test", src = "elf_e2e_test.rs", crate_name = "elf_development_test",
    extra_srcs = ["echo.rs", "transplant.rs"],
    deps = ["//testing/e2e", "//tools/qemu:qemu_test", "//host/debug_client"],
    extra_data = [":library_archive", ":probe_archive"],
    extra_args = ["$(rootpath :library_archive)", "$(rootpath :probe_archive)"],
)
qemu_e2e_test(
    name = "elf_test", src = "elf_e2e_test.rs", crate_name = "elf_test",
    extra_srcs = ["echo.rs", "transplant.rs"],
    deps = ["//testing/e2e", "//tools/qemu:qemu_test", "//host/debug_client"],
    extra_data = [":library_archive", ":probe_archive"],
    extra_args = ["$(rootpath :library_archive)", "$(rootpath :probe_archive)"],
)
qemu_e2e_test(
    name = "lazy_keychain_test", src = "lazy_keychain_e2e_test.rs", crate_name = "lazy_keychain_test",
    deps = ["//testing/e2e", "//tools/qemu:qemu_test", "//host/debug_client"],
    extra_data = [":library_archive", ":probe_archive"],
    extra_args = ["$(rootpath :library_archive)", "$(rootpath :probe_archive)"],
)
qemu_development_e2e_test(
    name = "lazy_keychain_development_test", src = "lazy_keychain_e2e_test.rs", crate_name = "lazy_keychain_development_test",
    deps = ["//testing/e2e", "//tools/qemu:qemu_test", "//host/debug_client"],
    extra_data = [":library_archive", ":probe_archive"],
    extra_args = ["$(rootpath :library_archive)", "$(rootpath :probe_archive)"],
)


load(":network_transplant.bzl", "network_transplant_test")
network_transplant_test("network_transplant_development_test", QEMU_DEVELOPMENT_BOOT_DATA, True)
network_transplant_test("network_transplant_test", QEMU_BOOT_DATA, False)
qemu_suites()
