metadata {
  target_board: "//device/virtual/qemu/base/x86_64"
  platform_profile: "virtual_x86_64"
  min_platform_version: 1
  architecture: ARCH_X86_64
}

runner_policy {
  component_runner_providers { runner_name: "elf" kind: DIRECT_ELF }
  component_runner_providers {
    runner_name: "wasm"
    kind: COMPONENT_RUNNER
    package_id: "bexos.platform.wasm_runner"
    executable_path: "/pkg/bin/wasm_runner"
    expected_signer: "bexos-dev-app-root"
  }
  component_runner_providers {
    runner_name: "nix"
    kind: COMPONENT_RUNNER
    package_id: "bexos.platform.starnix_runner"
    executable_path: "/pkg/bin/starnix_runner"
    expected_signer: "bexos-dev-app-root"
  }
  realtime_scheduling_allowlist { package_id: "bexos.service.splashd" expected_signer: "bexos_official_platform_v1" }
  realtime_scheduling_allowlist { package_id: "bexos.service.scened" expected_signer: "bexos_official_platform_v1" }
  default_tier: TIER_1_WASM
  allow_microvm_runner: true
  allow_starnix_runner: true

  microvm_constraints {
    max_vram_allocation_mb: 1024
    allow_network_bridge: false
    allow_pci_passthrough: false
  }

  allow_native_elf_runner: true

  native_elf_runner_allowlist { package_id: "bexos.sdk.fixture.service" expected_signer: "bexos-dev-app-root" }
  native_elf_runner_allowlist { package_id: "bexos.sdk.fixture.driver.e1000e" expected_signer: "bexos-dev-app-root" }

  native_elf_runner_allowlist {
    package_id: "bexos.platform.appd"
    expected_signer: "bexos_official_platform_v1"
  }
}

tee_policy {
  enforce_secure_boot: true
  rpmb_anti_rollback: true
  secure_storage_backend: QEMU_EMULATED_RPMB
  require_secure_persistent_keys: true
  allow_authenticated_firmware_selection: true
  orchestrator_verification: "sha256:a316842a26da7b9ad259fd62885f1e9d583f66960685fd588ce1bf72448a1c64"
  # Trusty upstream security applications are reached only by typed, privileged
  # host clients through teed. ConfirmationUI is intentionally omitted: QEMU
  # has no secure display/input ownership contract.
  allowed_trusted_apps: "bexos.ta.keymint"
  allowed_trusted_apps: "bexos.ta.gatekeeper"
  allowed_trusted_apps: "bexos.ta.storage"
  allowed_trusted_apps: "bexos.ta.avb"
  allowed_trusted_apps: "bexos.ta.authmgr"
  allowed_trusted_apps: "bexos.orchestrator"
}

driver_policy {
  tier_1_allowlist { package_id: "bexos.sdk.fixture.driver.e1000e" expected_signer: "bexos-dev-app-root" }
  tier_1_allowlist { package_id: "bexos.driver.input.virtio" expected_signer: "bexos_official_platform_v1" }
  tier_1_allowlist { package_id: "bexos.driver.rtc.cmos" expected_signer: "bexos_official_platform_v1" }
  default_unmatched_action: REJECT_AND_ISOLATE

  tier_1_allowlist {
    package_id: "bexos.driver.pci_root"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.serial.virtio_console"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.storage.nvme"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.storage.bexfs"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.storage.user_bexfs"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.storage.archivefs"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.storage.memfs"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.storage.diskimage"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.debugd"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.display.virtio_gpu"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.driver.network.virtio_net"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist { package_id: "bexos.driver.network.e1000e" expected_signer: "bexos_official_platform_v1" }
  tier_1_allowlist { package_id: "bexos.driver.network.igb" expected_signer: "bexos_official_platform_v1" }

  tier_1_allowlist {
    package_id: "bexos.service.updated"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_1_allowlist {
    package_id: "bexos.service.powerd"
    expected_signer: "bexos_official_platform_v1"
  }

  tier_2_rules {
    # The x86 kernel port has not established or attested DMA isolation.
    enforce_strict_iommu: false
    allow_raw_mmio: false
    max_dma_bandwidth_mbps: 1000
  }
}

update_policy {
  metadata_base_url: "https://distribution.bexos.org/metadata"
  targets_base_url: "https://distribution.bexos.org/targets"
  app_target_prefix: "apps/"
  kernel_target_name: "kernel.img"
  tee_target_name: "tee.bin"
  max_metadata_bytes: 1048576
  max_target_bytes: 67108864
  default_apply_policy: CHECK_ONLY
  trusted_root_keys {
    key_id: "bexos-qemu-test-ed25519-key-v001"
    public_key: "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
  }
}

app_lifecycle_policy {
  probation_window_seconds: 60
  crash_window_seconds: 60
  crash_threshold: 3
  restart_delay_seconds: 1
}

interface_defaults {
  interface_name: "bexos.shell.ShellProvider"
  package_name: "bexos.app.brush_shell"
  process_name: "terminal"
}

network_policy {
  max_dynamic_providers: 64
  resource_templates {
    name: "system_network"
    max_instances: 8
    cpu_weight: 100
    memory_high_bytes: 134217728
  }
  isolation_groups {
    name: "system_default"
    networkd_package: "bexos.service.networkd"
    networkd_process: "networkd"
    netstackd_package: "bexos.service.netstackd"
    netstackd_process: "netstackd"
    resource_template: "system_network"
    table_ids: 0
  }
  domains {
    name: "system_default"
    isolation_group: "system_default"
    table_id: 0
    system_default: true
  }
  virtual_ports {
    port_id: 1
    isolation_group: "system_default"
    table_id: 0
    physical_selector: "qemu-default"
    source_mac: "\x02\x00\x00\x00\x00\x01"
    rx_queue_depth: 256
    tx_queue_depth: 256
  }
  routes {
    isolation_group: "system_default"
    table_id: 0
    destination { address: "\x00\x00\x00\x00" prefix_len: 0 }
    gateway: "\x0a\x00\x02\x02"
    interface_id: 1
    metric: 100
  }
  dns_upstreams {
    isolation_group: "system_default"
    table_id: 0
    provider: "system_default"
    domain_suffix: "."
    bootstrap_address: "\x0a\x00\x02\x03"
    port: 53
    transport: NETWORK_DNS_UDP53
    priority: 100
  }
  workload_profiles {
    name: "starnix-direct"
    mode: WORKLOAD_NETWORK_DIRECT_PROVIDER
    isolation_group: "system_default"
    domain: "system_default"
    mtu: 1500
    rx_queue_depth: 128
    tx_queue_depth: 128
    addressing: WORKLOAD_ADDRESSING_DHCP_AND_SLAAC
    dns_servers: "\x0a\x00\x02\x03"
    max_instances: 16
    package_grants { package_id: "bexos.platform.starnix_fixture" expected_signer: "bexos-dev-app-root" }
  }
  workload_profiles {
    name: "starnix-l2-primary"
    mode: WORKLOAD_NETWORK_VIRTUAL_L2
    isolation_group: "system_default"
    domain: "system_default"
    physical_selector: "qemu-default"
    mtu: 1500
    rx_queue_depth: 128
    tx_queue_depth: 128
    addressing: WORKLOAD_ADDRESSING_STATIC
    static_addresses { address: "\x0a\x00\x02\x20" prefix_len: 24 }
    gateways { address: "\x0a\x00\x02\x02" prefix_len: 32 }
    dns_servers: "\x0a\x00\x02\x03"
    max_instances: 8
    allow_raw: true
    package_grants { package_id: "bexos.platform.starnix_fixture" expected_signer: "bexos-dev-app-root" }
  }
  workload_profiles {
    name: "starnix-l2-secondary"
    mode: WORKLOAD_NETWORK_VIRTUAL_L2
    isolation_group: "system_default"
    domain: "system_default"
    physical_selector: "qemu-default"
    vlan_id: 2
    mtu: 1500
    rx_queue_depth: 128
    tx_queue_depth: 128
    addressing: WORKLOAD_ADDRESSING_STATIC
    static_addresses { address: "\x0a\x01\x00\x20" prefix_len: 24 }
    max_instances: 8
    allow_raw: true
    package_grants { package_id: "bexos.platform.starnix_fixture" expected_signer: "bexos-dev-app-root" }
  }
}
