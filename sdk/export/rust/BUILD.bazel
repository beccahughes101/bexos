load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.sdk.bazel"])

rust_library(
    name = "bexos_app",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_app",
    edition = "2024",
)

rust_library(
    name = "bexos_wasm_guest",
    srcs = ["wasm_guest.rs"],
    crate_name = "bexos_wasm_guest",
    compile_data = ["wasm.wit"],
    edition = "2024",
    rustc_env = {"CARGO_MANIFEST_DIR": "."},
    deps = ["@brush_crates//:wit-bindgen"],
)

filegroup(
    name = "files",
    srcs = glob(["src/**/*.rs"]) + [
        "wasm.wit",
        "wasm_guest.rs",
    ],
)

filegroup(name = "sdk_build", srcs = ["BUILD.sdk.bazel"])
