load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])


rust_library(
    name = "orchestrator",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_orchestrator",
    edition = "2024",
    deps = [":tee_slots", "//kernel/core"],
)

rust_test(
    name = "orchestrator_tests",
    srcs = ["tests/orchestrator_tests.rs"],
    crate_name = "orchestrator_tests",
    edition = "2024",
    deps = [
        ":orchestrator",
        "//kernel/core",
    ],
)

rust_test(
    name = "tee_slots_tests",
    srcs = ["tests/tee_slots_tests.rs"],
    edition = "2024",
    deps = [":orchestrator", "@crates__sha2-0.11.0//:sha2"],
)

# Firmware-safe state machine: no dependency on kernel/core or alloc.
rust_library(
    name = "tee_slots",
    srcs = ["src/slot_lib.rs", "src/slot_types.rs", "src/tee_slots.rs", "src/slot_wire.rs", "src/live.rs", "src/live_wire.rs", "src/writer.rs"],
    crate_root = "src/slot_lib.rs",
    crate_name = "bexos_tee_slots",
    edition = "2024",
    deps = ["@crates__sha2-0.11.0//:sha2"],
)

rust_test(
    name = "live_tests",
    srcs = ["tests/live_tests.rs"],
    edition = "2024",
    deps = [":tee_slots"],
)
