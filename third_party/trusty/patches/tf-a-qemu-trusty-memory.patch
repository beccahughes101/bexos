@@ -145,0 +147,12 @@
+#ifdef BEXOS_SEL2_OWNER
+	/*
+	 * Both the normal world and the permanent secure execution owner run at
+	 * EL2.  The Trusty SPD predates S-EL2 and therefore does not otherwise
+	 * preserve the caller's stack or hypervisor controls while its assembly
+	 * helper swaps the EL3 C stacks and changes security state.
+	 */
+	u_register_t saved_sp_el2 = read_sp_el2();
+	u_register_t saved_hcr_el2 = read_hcr_el2();
+	u_register_t saved_cntkctl_el1 = read_cntkctl_el1();
+#endif
+
@@ -149,0 +163,7 @@
+
+#ifdef BEXOS_SEL2_OWNER
+	write_sp_el2(saved_sp_el2);
+	write_hcr_el2(saved_hcr_el2);
+	write_cntkctl_el1(saved_cntkctl_el1);
+	isb();
+#endif
@@ -171 +191,2 @@
-	ret = trusty_context_switch(NON_SECURE, SMC_FC_FIQ_ENTER, 0, 0, 0);
+	ret = trusty_context_switch(NON_SECURE, SMC_FC_FIQ_ENTER, 0, 0, 0,
+				    0, 0, 0, 0);
@@ -229 +250,2 @@
