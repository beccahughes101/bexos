+			ret = trusty_context_switch(SECURE, x1, x2, x3, x4,
+					    0, 0, 0, 0);
@@ -301,0 +325,11 @@
+#ifdef BEXOS_SEL2_OWNER
+			if (smc_fid == U(0xfb00be00)) {
+				ret = trusty_context_switch(NON_SECURE, smc_fid, x1,
+					x2, x3, x4,
+					SMC_GET_GP(handle, CTX_GPREG_X5),
+					SMC_GET_GP(handle, CTX_GPREG_X6),
+					SMC_GET_GP(handle, CTX_GPREG_X7));
+				SMC_RET8(handle, ret.r0, ret.r1, ret.r2, ret.r3,
+					 ret.r4, ret.r5, ret.r6, ret.r7);
+			}
+#endif
@@ -309 +343 @@
-				x2, x3);
+				x2, x3, 0, 0, 0, 0);
@@ -353,0 +388,9 @@
+#ifdef BEXOS_SEL2_OWNER
+	/* The Trusty SPD normally targets S-EL1. The authenticated BexOS BL32 is
+	 * the permanent S-EL2 owner, so admit its requested exception level in
+	 * the saved secure context used by the initial EL3 return. */
+	el3_state_t *el3_state = get_el3state_ctx(&ctx->cpu_ctx);
+	write_ctx_reg(el3_state, CTX_SCR_EL3,
+		      read_ctx_reg(el3_state, CTX_SCR_EL3) | SCR_EEL2_BIT);
+#endif
+
@@ -427 +470,2 @@
