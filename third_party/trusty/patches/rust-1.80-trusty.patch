+#[cfg(target_os = "trusty")]
+fn trusty_write(fd: i32, buf: &[u8]) -> io::Result<usize> {
+    extern "C" {
+        #[link_name = "trusty_write"]
+        fn native_write(fd: i32, bytes: *const u8, len: usize) -> isize;
+    }
+    // Trusty's raw libc wrapper preserves negative LK status values and
+    // writes through the native syscall, never S-EL0 semihosting.
+    let result = unsafe { native_write(fd, buf.as_ptr(), buf.len()) };
+    if result < 0 {
+        Err(io::Error::from(io::ErrorKind::Other))
+    } else {
+        Ok(result as usize)
+    }
+}
+
+#[cfg(target_os = "trusty")]
+pub fn panic_output() -> Option<Stderr> {
+    Some(Stderr::new())
+}
+
+#[cfg(not(target_os = "trusty"))]
 pub fn panic_output() -> Option<Vec<u8>> {
     None
 }
