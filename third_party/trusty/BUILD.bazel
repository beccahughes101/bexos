# A product's monitor, signed policy and RPMB transport must select the same
# saved bundle. Architecture transitions preserve this product selection.
[alias(
    name = "product_x86/" + artifact,
    actual = select({
        "//build/platforms:trusty_acceptance": ":cached_x86_64_acceptance/" + artifact,
        "//conditions:default": ":cached_x86_64/" + artifact,
    }),
) for artifact in ["lk.elf", "rpmb_dev", "RPMB_DATA"]]

