)

genrule(
    name = "built_image",
    tags = ["manual"],
    srcs = [":trusty_qemu_firmware"],
    outs = ["built/image.bin"],
    tools = [":image_bundle_tool"],
    cmd = "$(location :image_bundle_tool) pack $@ $(locations :trusty_qemu_firmware)",
)

sh_binary(
    name = "refresh_image",
    tags = ["manual"],
    srcs = ["image_bundle.sh"],
    data = ["image_bundle.py", ":built_image"],
    args = ["refresh", "third_party/trusty/image.bin", "$(location :built_image)"],
)

filegroup(
    name = "saved_image",
    srcs = glob(["image.bin"], allow_empty = True),
)

genrule(
    name = "cached_firmware",
    # Package-state security changes must reach products without checked-in binaries.
    srcs = [":built_image"],
    outs = [
        "bl1.bin", "bl2.bin", "bl31.bin", "lk.bin", "lk.elf", "bl33.bin",
        "bl33-rollback.bin", "rollback_nt_fw_content.crt",
        "nt_fw_content.crt", "nt_fw_key.crt", "rpmb_dev", "RPMB_DATA",
        "soc_fw_content.crt", "soc_fw_key.crt", "tb_fw.crt",
        "tos_fw_content.crt", "tos_fw_key.crt", "trusted_key.crt", "build.prototxt",
    ],
    tools = [":image_bundle_tool"],
    cmd = "$(location :image_bundle_tool) extract $(@D) $(SRCS)",
)

# The saved ARM `lk.bin` is the complete signed S-EL2 container. Owner-only
# link checks need the raw position-independent Trusty payload from `lk.elf`
# so they cannot recursively embed an earlier owner inside a new one.
genrule(
    name = "cached_aarch64_payload",
    srcs = [":lk.elf"],
    outs = ["cached_payload/lk.bin"],
    tools = ["@llvm//tools:llvm-objcopy"],
    cmd = "$(location @llvm//tools:llvm-objcopy) -O binary $(location :lk.elf) $@",
)

genrule(
    name = "built_authmgr_acceptance_image",
    tags = ["manual"],
    srcs = [":authmgr_acceptance_firmware"],
    outs = ["built_acceptance/image.bin"],
    tools = [":image_bundle_tool"],
    cmd = "$(location :image_bundle_tool) --variant authmgr_acceptance pack $@ $(locations :authmgr_acceptance_firmware)",
)
sh_binary(
    name = "refresh_authmgr_acceptance_image",
    tags = ["manual"],
    srcs = ["image_bundle.sh"],
    data = ["image_bundle.py", ":built_authmgr_acceptance_image"],
    args = ["--variant", "authmgr_acceptance", "refresh", "third_party/trusty/authmgr_acceptance_image.bin", "$(location :built_authmgr_acceptance_image)"],
)
filegroup(name = "saved_authmgr_acceptance_image", srcs = glob(["authmgr_acceptance_image.bin"], allow_empty = True))
genrule(
    name = "cached_authmgr_acceptance_firmware",
    srcs = [":saved_authmgr_acceptance_image"],
    outs = ["acceptance_cached/" + name for name in [
        "bl1.bin", "bl2.bin", "bl31.bin", "lk.bin", "lk.elf", "bl33.bin",
        "bl33-rollback.bin", "rollback_nt_fw_content.crt",
        "nt_fw_content.crt", "nt_fw_key.crt", "rpmb_dev", "RPMB_DATA",
        "soc_fw_content.crt", "soc_fw_key.crt", "tb_fw.crt",
        "tos_fw_content.crt", "tos_fw_key.crt", "trusted_key.crt", "build.prototxt",
    ]],
    tools = [":image_bundle_tool"],
    cmd = "$(location :image_bundle_tool) --variant authmgr_acceptance extract $(@D)/acceptance_cached $(SRCS)",
)
filegroup(name = "acceptance_certificates", srcs = [":acceptance_cached/" + name for name in [
    "nt_fw_content.crt", "nt_fw_key.crt", "soc_fw_content.crt", "soc_fw_key.crt", "tb_fw.crt", "tos_fw_content.crt", "tos_fw_key.crt", "trusted_key.crt",
]])

