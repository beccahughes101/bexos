+    pub(crate) async fn read_to_string(&mut self)->std::io::Result<String>{
+        use std::io::Read;
+        let mut result=Vec::new();let mut bytes=[0;4096];
+        loop {match self.0.read(&mut bytes){
+            Ok(0)=>return String::from_utf8(result).map_err(std::io::Error::other),
+            Ok(n)=>{if result.len()+n>1<<20{return Err(std::io::Error::other("command substitution exceeds 1 MiB"));}result.extend_from_slice(&bytes[..n]);},
