+//! Bounded in-process pipes used by cooperative WASM tasks.
+use std::{collections::VecDeque,io::{self,Read,Write},sync::{Arc,Mutex}};
+const LIMIT:usize=32768;
+#[derive(Default)]struct State{bytes:VecDeque<u8>,readers:usize,writers:usize}
+pub struct Reader(Arc<Mutex<State>>);
+pub struct Writer(Arc<Mutex<State>>);
+pub fn pipe()->io::Result<(Reader,Writer)>{let state=Arc::new(Mutex::new(State{readers:1,writers:1,..Default::default()}));Ok((Reader(state.clone()),Writer(state)))}
+impl Clone for Reader{fn clone(&self)->Self{self.0.lock().unwrap().readers+=1;Self(self.0.clone())}}
+impl Clone for Writer{fn clone(&self)->Self{self.0.lock().unwrap().writers+=1;Self(self.0.clone())}}
+impl Drop for Reader{fn drop(&mut self){self.0.lock().unwrap().readers-=1;}}
+impl Drop for Writer{fn drop(&mut self){self.0.lock().unwrap().writers-=1;}}
+impl Read for Reader{fn read(&mut self,out:&mut[u8])->io::Result<usize>{let mut s=self.0.lock().unwrap();let n=out.len().min(s.bytes.len());if n==0 && !out.is_empty() && s.writers!=0{return Err(io::ErrorKind::WouldBlock.into());}for byte in &mut out[..n]{*byte=s.bytes.pop_front().unwrap();}Ok(n)}}
+impl Write for Writer{fn write(&mut self,input:&[u8])->io::Result<usize>{let mut s=self.0.lock().unwrap();if s.readers==0{return Err(io::ErrorKind::BrokenPipe.into());}let n=input.len().min(LIMIT-s.bytes.len());if n==0 && !input.is_empty(){return Err(io::ErrorKind::WouldBlock.into());}s.bytes.extend(&input[..n]);Ok(n)}fn flush(&mut self)->io::Result<()>{Ok(())}}
+impl Write for Reader{fn write(&mut self,_:&[u8])->io::Result<usize>{Err(io::ErrorKind::PermissionDenied.into())}fn flush(&mut self)->io::Result<()>{Ok(())}}
+impl Read for Writer{fn read(&mut self,_:&mut[u8])->io::Result<usize>{Err(io::ErrorKind::PermissionDenied.into())}}
+impl crate::openfiles::Stream for Reader{fn clone_box(&self)->Box<dyn crate::openfiles::Stream>{Box::new(self.clone())}}
+impl crate::openfiles::Stream for Writer{fn clone_box(&self)->Box<dyn crate::openfiles::Stream>{Box::new(self.clone())}}
+impl From<Reader> for crate::openfiles::OpenFile{fn from(r:Reader)->Self{Self::Stream(Box::new(r))}}
+impl From<Writer> for crate::openfiles::OpenFile{fn from(w:Writer)->Self{Self::Stream(Box::new(w))}}
