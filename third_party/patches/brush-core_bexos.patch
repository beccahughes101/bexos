@@ -0,0 +1,56 @@
+//! Cooperative execution boundary for the BexOS service event loop.
+use std::cell::Cell;
+thread_local! { static INTERRUPTED: Cell<bool> = const { Cell::new(false) }; }
+/// Set the cancellation state of the session about to be polled.
+pub fn set_interrupted(value: bool) { INTERRUPTED.set(value); } pub fn interrupted() -> bool { INTERRUPTED.get() }
+pub(crate) async fn yield_execution() -> Result<(), crate::Error> {
+    tokio::task::yield_now().await;
+    if INTERRUPTED.get() { return Err(crate::error::ErrorKind::Interrupted.into()); }
+    Ok(())
+}
+
+/// Owned request at the boundary between Brush evaluation and appd execution.
+pub struct Command {
+    pub name: String,
+    pub arguments: Vec<String>,
+    pub environment: Vec<(String, String)>,
+    pub cwd: std::path::PathBuf,
+    pub path: Vec<std::path::PathBuf>,
+    pub files: [Option<crate::openfiles::OpenFile>; 3],
+}
+pub type CommandFuture = std::pin::Pin<Box<dyn std::future::Future<Output = Result<crate::ExecutionResult, crate::Error>> + Send>>;
+pub type Launcher = fn(Command) -> CommandFuture;
+thread_local! { static LAUNCHER: Cell<Option<Launcher>> = const { Cell::new(None) }; }
+/// Install the capability-based process adapter for this service instance.
+pub fn set_launcher(launcher: Launcher) { LAUNCHER.set(Some(launcher)); }
+pub async fn launch(command: Command) -> Result<crate::ExecutionResult, crate::Error> {
+    match LAUNCHER.get() {
+        Some(launch) => launch(command).await,
+        None => Err(crate::error::ErrorKind::CommandNotFound(command.name).into()),
+    }
+}
+/// Whether another input line can complete this parse.
+pub fn incomplete(error: &brush_parser::ParseError) -> bool {
+    match error {
+        brush_parser::ParseError::ParsingAtEndOfInput => true,
+        brush_parser::ParseError::Tokenizing { inner, .. } => inner.is_incomplete(),
+        _ => false,
+    }
+}
+
+pub mod pipe;
+/// Cooperative bounded output: retain the exact unwritten suffix across yields.
+pub async fn write_all(mut writer: impl std::io::Write, bytes: &[u8]) -> Result<(), crate::Error> {
+    let mut offset=0;
+    while offset<bytes.len() {
+        yield_execution().await?;
+        match writer.write(&bytes[offset..]) {
+            Ok(0)=>return Err(std::io::Error::from(std::io::ErrorKind::WriteZero).into()),
+            Ok(n)=>offset+=n,
+            Err(e) if e.kind()==std::io::ErrorKind::WouldBlock=>(),
+            Err(e)=>return Err(e.into()),
+        }
+    }
+    writer.flush()?;
+    Ok(())
+}
