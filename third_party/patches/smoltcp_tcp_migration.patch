+    /// Capture enough established TCP state for BexOS to recreate the socket
+    /// in-place during a live migration without initiating a new SYN.
+    #[cfg(feature = "alloc")]
+    pub fn checkpoint(&self, now: Instant) -> MigrationState {
+        let mut rx_bytes = Vec::with_capacity(self.rx_buffer.len());
+        copy_buffer(&self.rx_buffer, &mut rx_bytes);
+        let mut tx_bytes = Vec::with_capacity(self.tx_buffer.len());
+        copy_buffer(&self.tx_buffer, &mut tx_bytes);
+        let (local_endpoint, remote_endpoint) = match self.tuple {
+            Some(tuple) => (Some(tuple.local), Some(tuple.remote)),
+            None => (None, None),
+        };
+        MigrationState {
+            state: self.state,
+            listen_endpoint: self.listen_endpoint,
+            local_endpoint,
+            remote_endpoint,
+            local_seq_no: self.local_seq_no.0,
+            remote_seq_no: self.remote_seq_no.0,
+            remote_last_seq: self.remote_last_seq.0,
+            remote_last_ack: self.remote_last_ack.map(|seq| seq.0),
+            remote_last_win: self.remote_last_win,
+            remote_win_shift: self.remote_win_shift,
+            remote_win_len: self.remote_win_len,
+            remote_win_scale: self.remote_win_scale,
+            remote_has_sack: self.remote_has_sack,
+            remote_mss: self.remote_mss,
+            remote_last_ts_delta_millis: self.remote_last_ts.map(|instant| instant_delta(now, instant)),
+            local_rx_last_seq: self.local_rx_last_seq.map(|seq| seq.0),
+            local_rx_last_ack: self.local_rx_last_ack.map(|seq| seq.0),
+            local_rx_dup_acks: self.local_rx_dup_acks,
+            pending_fast_retransmit: self.pending_fast_retransmit,
+            rx_fin_received: self.rx_fin_received,
+            timeout_millis: self.timeout.map(|duration| duration.total_millis()),
+            keep_alive_millis: self.keep_alive.map(|duration| duration.total_millis()),
+            hop_limit: self.hop_limit,
+            ack_delay_millis: self.ack_delay.map(|duration| duration.total_millis()),
+            nagle: self.nagle,
+            last_remote_tsval: self.last_remote_tsval,
+            rtte: MigrationRttEstimator {
+                have_measurement: self.rtte.have_measurement,
+                srtt_millis: self.rtte.srtt,
+                rttvar_millis: self.rtte.rttvar,
