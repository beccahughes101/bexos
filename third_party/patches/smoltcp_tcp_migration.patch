+#[cfg(feature = "alloc")]
+fn instant_delta(now: Instant, instant: Instant) -> i64 {
+    instant.total_millis() - now.total_millis()
+}
+
+#[cfg(feature = "alloc")]
+fn instant_from_delta(now: Instant, delta_millis: i64) -> Instant {
+    Instant::from_millis(now.total_millis() + delta_millis)
+}
