+    /// Export sparse receive assembler ranges for BexOS TCP migration.
+    #[cfg(feature = "alloc")]
+    pub fn migration_ranges(&self) -> Vec<(usize, usize)> {
+        let mut ranges = Vec::new();
+        for contig in self.contigs.iter() {
+            if !contig.has_data() {
+                break;
+            }
+            ranges.push((contig.hole_size, contig.data_size));
+        }
+        ranges
+    }
+
+    /// Restore sparse receive assembler ranges captured by BexOS TCP migration.
+    #[cfg(feature = "alloc")]
+    pub fn restore_migration_ranges(
+        &mut self,
+        ranges: &[(usize, usize)],
+    ) -> Result<(), TooManyHolesError> {
+        self.clear();
+        if ranges.len() > self.contigs.len() {
+            return Err(TooManyHolesError);
+        }
+        for (slot, (hole_size, data_size)) in self.contigs.iter_mut().zip(ranges.iter().copied()) {
+            *slot = Contig::hole_and_data(hole_size, data_size);
+        }
+        Ok(())
     }
 
