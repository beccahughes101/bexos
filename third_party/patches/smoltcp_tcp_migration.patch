+#[cfg(feature = "alloc")]
+fn copy_buffer(buffer: &SocketBuffer<'_>, out: &mut Vec<u8>) {
+    let mut offset = 0usize;
+    while offset < buffer.len() {
+        let bytes = buffer.get_allocated(offset, buffer.len() - offset);
+        if bytes.is_empty() {
+            break;
+        }
+        out.extend_from_slice(bytes);
+        offset += bytes.len();
     }
