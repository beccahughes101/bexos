+    }
+
+    /// Restore a BexOS TCP checkpoint into a fresh socket. Buffer capacities
+    /// must be large enough for the captured RX/TX data.
+    #[cfg(feature = "alloc")]
+    pub fn restore(&mut self, checkpoint: MigrationState, now: Instant) -> Result<(), ()> {
+        if checkpoint.rx_bytes.len() > self.rx_buffer.capacity()
+            || checkpoint.tx_bytes.len() > self.tx_buffer.capacity()
+        {
+            return Err(());
+        }
+        self.reset();
+        self.state = checkpoint.state;
+        self.listen_endpoint = checkpoint.listen_endpoint;
+        self.tuple = match (checkpoint.local_endpoint, checkpoint.remote_endpoint) {
+            (Some(local), Some(remote)) => Some(Tuple { local, remote }),
+            _ => None,
+        };
+        self.local_seq_no = TcpSeqNumber(checkpoint.local_seq_no);
+        self.remote_seq_no = TcpSeqNumber(checkpoint.remote_seq_no);
+        self.remote_last_seq = TcpSeqNumber(checkpoint.remote_last_seq);
+        self.remote_last_ack = checkpoint.remote_last_ack.map(TcpSeqNumber);
+        self.remote_last_win = checkpoint.remote_last_win;
+        self.remote_win_shift = checkpoint.remote_win_shift;
+        self.remote_win_len = checkpoint.remote_win_len;
+        self.remote_win_scale = checkpoint.remote_win_scale;
+        self.remote_has_sack = checkpoint.remote_has_sack;
+        self.remote_mss = checkpoint.remote_mss.max(MIN_REMOTE_MSS);
+        self.remote_last_ts = checkpoint
+            .remote_last_ts_delta_millis
+            .map(|delta| instant_from_delta(now, delta));
+        self.local_rx_last_seq = checkpoint.local_rx_last_seq.map(TcpSeqNumber);
+        self.local_rx_last_ack = checkpoint.local_rx_last_ack.map(TcpSeqNumber);
+        self.local_rx_dup_acks = checkpoint.local_rx_dup_acks;
+        self.pending_fast_retransmit = checkpoint.pending_fast_retransmit;
+        self.rx_fin_received = checkpoint.rx_fin_received;
+        self.timeout = checkpoint.timeout_millis.map(Duration::from_millis);
+        self.keep_alive = checkpoint.keep_alive_millis.map(Duration::from_millis);
+        self.hop_limit = checkpoint.hop_limit;
+        self.ack_delay = checkpoint.ack_delay_millis.map(Duration::from_millis);
+        self.nagle = checkpoint.nagle;
+        self.last_remote_tsval = checkpoint.last_remote_tsval;
+        self.rtte = RttEstimator {
+            have_measurement: checkpoint.rtte.have_measurement,
+            srtt: checkpoint.rtte.srtt_millis,
+            rttvar: checkpoint.rtte.rttvar_millis,
+            rto: checkpoint.rtte.rto_millis,
+            timestamp: checkpoint
+                .rtte
+                .timestamp_delta_millis
+                .map(|(delta, seq)| (instant_from_delta(now, delta), TcpSeqNumber(seq))),
+            max_seq_sent: checkpoint.rtte.max_seq_sent.map(TcpSeqNumber),
+            rto_count: checkpoint.rtte.rto_count,
+        };
+        self.rx_buffer.enqueue_slice(&checkpoint.rx_bytes);
+        self.tx_buffer.enqueue_slice(&checkpoint.tx_bytes);
+        self.assembler = Assembler::new();
+        if !checkpoint.assembler_ranges.is_empty() {
+            self.assembler
+                .restore_migration_ranges(&checkpoint.assembler_ranges)
+                .map_err(|_| ())?;
+        } else if !checkpoint.rx_bytes.is_empty() {
+            let _ = self.assembler.add(0, checkpoint.rx_bytes.len());
+        }
+        self.timer.set_for_idle(now, self.keep_alive);
+        Ok(())
+    }
