+++ b/src/virtio/vulkan/vn_common.c
@@ -92,7 +92,16 @@
    va_list ap;
 
    va_start(ap, format);
+#ifdef BEXOS_VENUS
+   /* Services need no ambient Unix standard streams for diagnostics. */
+   extern void bexos_venus_log(const char *text, size_t length);
+   char text[1024];
+   int length = vsnprintf(text, sizeof(text), format, ap);
+   if (length > 0)
+      bexos_venus_log(text, MIN2((size_t)length, sizeof(text) - 1));
+#else
    mesa_log_v(MESA_LOG_DEBUG, "MESA-VIRTIO", format, ap);
+#endif
    va_end(ap);
 
