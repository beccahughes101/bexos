+    /// Returns an opaque migration snapshot for the raw device.
+    #[cfg(feature = "alloc")]
+    pub fn migration_snapshot(&self) -> Vec<u8> {
+        let mut out = Vec::new();
+        out.extend_from_slice(&(core::mem::size_of::<Self>() as u64).to_le_bytes());
+        let ptr = self as *const Self as *const u8;
+        // SAFETY: We are copying the byte representation of a live driver into
+        // an opaque snapshot. The original object remains owned by the caller.
+        let bytes = unsafe { core::slice::from_raw_parts(ptr, core::mem::size_of::<Self>()) };
+        out.extend_from_slice(bytes);
+        out
+    }
+
+    /// Adopts a raw device from an opaque migration snapshot.
+    ///
+    /// # Safety
+    ///
+    /// The snapshot must come from the same crate version, target, queue size,
+    /// HAL, transport type and preserved address space mappings.
+    #[cfg(feature = "alloc")]
+    pub unsafe fn adopt_migration_snapshot(bytes: &[u8]) -> Result<Self> {
+        if bytes.len() < 8 {
+            return Err(Error::InvalidParam);
+        }
+        let mut size = [0u8; 8];
+        size.copy_from_slice(&bytes[..8]);
+        if u64::from_le_bytes(size) as usize != core::mem::size_of::<Self>()
+            || bytes.len() != 8 + core::mem::size_of::<Self>()
+        {
+            return Err(Error::InvalidParam);
+        }
+        let mut out = core::mem::MaybeUninit::<Self>::uninit();
+        // SAFETY: The caller guarantees the snapshot matches this exact type.
+        unsafe {
+            core::ptr::copy_nonoverlapping(
+                bytes[8..].as_ptr(),
+                out.as_mut_ptr() as *mut u8,
+                core::mem::size_of::<Self>(),
+            );
+        }
+        // SAFETY: The bytes have just initialized the object.
+        let mut this = unsafe { out.assume_init() };
+        this.transport.disarm_migration_drop();
+        this.recv_queue.disarm_migration_drop();
+        this.send_queue.disarm_migration_drop();
+        Ok(this)
+    }
+
+    /// Marks an adopted migration snapshot as the live owner after commit.
+    pub fn activate_migration_owner(&mut self) {
+        self.transport.activate_migration_owner();
+        self.recv_queue.activate_migration_owner();
+        self.send_queue.activate_migration_owner();
     }
 
