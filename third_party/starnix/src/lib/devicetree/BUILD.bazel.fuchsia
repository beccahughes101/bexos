load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

rustc_library(
    name = "devicetree",
    srcs = [
        "src/lib.rs",
        "src/parser.rs",
        "src/types.rs",
    ],
    crate_name = "devicetree",
    edition = "2024",
    version = "0.1.0",
    with_unit_tests = True,
    deps = [
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)
