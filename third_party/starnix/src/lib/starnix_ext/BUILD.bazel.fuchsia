load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(
    default_applicable_licenses = ["//:license"],
    default_visibility = ["//visibility:public"],
)

rustc_library(
    name = "starnix_ext",
    srcs = [
        "src/lib.rs",
        "src/map_ext.rs",
    ],
    crate_name = "starnix_ext",
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    version = "0.1.0",
    with_unit_tests = True,
)
