library bexos.app.manager;
type InstallArtifactKind = strict enum : uint8 { APPLICATION = 1; DRIVER = 2; FONT = 3; FIRMWARE = 4; };
type ArtifactDigestHash = strict enum : uint8 { SHA256 = 1; BLAKE3 = 2; };

struct ExpectedArtifactDigest {
    hash_type ArtifactDigestHash;
    digest array<uint8, 32>;
};
struct InstallArtifactQuery {
    registry_host string:128;
    repository string:128;
    tag string:64;
    expected_digest vector<ExpectedArtifactDigest>:1;
    kind InstallArtifactKind;
};

type AppManagerStatus = strict enum : int32 {
    OK = 0,
    NOT_FOUND = -1,
    INVALID_ARGS = -8,
    ACCESS_DENIED = -10,
    STORAGE = -20,
    VERIFY_FAILED = -21,
    NETWORK = -30,
};

type AssociationStatus = strict enum : uint8 {
    VERIFIED = 1,
    DOMAIN_UNREACHABLE = 2,
    SIGNING_KEY_MISMATCH = 3,
    ORIGIN_MISMATCH = 4,
};

protocol AppManager {
    4: InstallAppFromArtifact(struct { query InstallArtifactQuery; }) -> (struct {
        status AppManagerStatus;
        allocated_package_id string:128;
    });
    1: InstallAppFromUrl(struct {
        url string:2048;
    }) -> (struct {
        status AppManagerStatus;
        allocated_package_id string:128;
        association AssociationStatus;
    });

    2: ReloadWellKnownForDomain(struct {
        domain string:255;
    }) -> (struct {
        status AppManagerStatus;
        association AssociationStatus;
        updated_handlers_count uint32;
    });

    3: GetDomainAssociation(struct {
        package_id string:128;
    }) -> (struct {
        status AppManagerStatus;
        domain string:255;
        association AssociationStatus;
        last_verified_timestamp uint64;
    });
};
