library bexos.app.bootstrap;

resource struct NamespaceEntry {
    path string:64;
    directory handle:CHANNEL;
};

enum HardwareResourceKind : uint8 {
    MMIO = 1;
    INTERRUPT = 2;
    DMA_POOL = 3;
    IOMMU_DOMAIN = 4;
    REGISTER_PROXY = 5;
    BUS_CONTROL = 6;
};

resource struct DriverResource {
    kind HardwareResourceKind;
    resource_id uint64;
    base uint64;
    length uint64;
    flags uint64;
    resource handle;
};

/// Role-specific resources: appd [BootFS], PCI [registry], NVMe
/// [MMIO], BexFS [block], disk verification [pkg directory, data directory].
/// Namespace entries are copied into owned storage before BootFS is released.
resource struct Startup {
    version uint32;
    resources vector<handle>:16;
    arg0 uint64;
    arg1 uint64;
    namespace vector<NamespaceEntry>:16;
    namespace_paths string:256;
    migration vector<handle>:1;
    migration_generation uint64;
    migration_target bool;
    service_grant_endpoints vector<handle>:16;
    service_grant_descriptors string:1024;
    config vector<handle>:1;
    config_len uint64;
    config_endpoint vector<handle>:1;
    linker_data vector<handle>:1;
    linker_data_len uint64;
    trace_producer vector<handle>:1;
    trace_mapped_len uint64;
    trace_producer_id uint64;
    trace_pid uint64;
    trace_main_tid uint64;
    driver_resources vector<DriverResource>:16;
    driver_lifecycle vector<handle>:1;
    incoming_service_endpoints vector<handle>:16;
    incoming_service_descriptors string:1024;
    lazy_idle_timeout_ms uint32;
    lazy_generation uint64;
    locale_data vector<handle>:1;
    locale_data_len uint64;
    locale_data_generation uint64;
    locale_settings vector<uint8>:4096;
    /// Appd-owned end of the per-host controller is retained across restart.
    driver_host_controller vector<handle>:1;
    /// VMO containing the versioned per-host recovery/migration journal.
    driver_recovery vector<handle>:1;
};

struct Ready { status int32; };

// Frozen wire layouts used to decode already-built clients.
resource struct StartupV6 {
    version uint32;
    resources vector<handle>:16;
    arg0 uint64;
    arg1 uint64;
    namespace vector<NamespaceEntry>:16;
