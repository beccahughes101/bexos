load("//build/rules:app_archive.bzl", "app_archive")
load("//build/rules:userspace.bzl", "app_manifest")
load("//build/rules:wasm.bzl", "wasi_component")

package(default_visibility = ["//visibility:public"])

wasi_component(
    name = "wasm",
    crate_name = "bexos_dioxus_demo",
    srcs = glob(["src/**/*.rs"]),
    deps = ["//lib/dioxus_guest", "//lib/dioxus_dom", "//lib/dioxus_scene"],
)

app_manifest(name = "manifest", src = "package/manifest.prototxt")
app_manifest(name = "replacement_manifest", src = "package/replacement.prototxt")

app_archive(
    name = "dioxus_demo",
    manifest = ":manifest",
    entries = {"bin/dioxus_demo.wasm": ":wasm"},
    compression = "zstd",
)

app_archive(
    name = "replacement_archive",
    manifest = ":replacement_manifest",
    entries = {"bin/dioxus_demo.wasm": ":wasm"},
    compression = "zstd",
)
