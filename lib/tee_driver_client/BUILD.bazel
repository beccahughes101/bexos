load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tee_driver_client",
    srcs = ["src/lib.rs"],
    crate_name = "bexos_tee_driver_client",
    edition = "2024",
    deps = [
        "//lib/userspace",
