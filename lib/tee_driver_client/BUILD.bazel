)

rust_test(
    name = "tee_driver_client_tests",
    srcs = ["tests/tee_driver_client_tests.rs"],
    crate_name = "tee_driver_client_tests",
    edition = "2024",
    deps = [
        ":tee_driver_client",
        "//lib/userspace",
    ],
)
