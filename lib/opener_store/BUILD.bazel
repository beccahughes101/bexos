load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "opener_store",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_opener_store",
    edition = "2024",
    deps = [
        "//lib/redb",
    ],
)

rust_library(
    name = "opener_store_host",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["std", "redb_backend"],
    crate_name = "bexos_opener_store",
    edition = "2024",
    deps = [
        "//lib/redb:redb_host",
        "@crates//:redb",
    ],
)

rust_library(
    name = "opener_store_bexos_std",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["std", "redb_backend"],
    crate_name = "bexos_opener_store",
    edition = "2024",
    deps = [
        "//lib/redb:redb_bexos_std",
        "@crates//:redb",
    ],
)

rust_test(
    name = "opener_store_tests",
    srcs = ["tests/opener_store_tests.rs"],
    crate_name = "opener_store_tests",
    edition = "2024",
    deps = [
        ":opener_store_host",
        "//lib/redb:redb_host",
    ],
)
