load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])
filegroup(name = "sdk_files", srcs = ["BUILD.bazel"] + glob(["src/**/*.rs"]))

rust_library(
    name = "migration",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_migration",
    edition = "2024",
)

rust_test(
    name = "migration_tests",
    srcs = ["tests/migration_tests.rs"],
    edition = "2024",
    deps = [":migration"],
)
