load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
package(default_visibility = ["//visibility:public"])

rust_library(
    name = "i18n",
    srcs = glob(["src/*.rs"]),
    crate_name = "bexos_i18n_client",
    edition = "2024",
    deps = [
        "//lib/ui/i18n",
        "//lib/userspace",
        "//lib/i18n/catalog",
        "//lib/i18n/settings",
        "//lib/i18n/formatting",
        "//idl:locale_fidl_rust",
        "//idl:kernel_fidl_rust",
    ],
)
rust_test(name = "tests", crate = ":i18n")
