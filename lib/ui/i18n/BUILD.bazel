load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
package(default_visibility = ["//visibility:public"])

rust_library(
    name = "i18n",
    srcs = glob(["src/*.rs"]),
    crate_name = "bexos_ui_i18n",
    edition = "2024",
    deps = ["//lib/i18n/catalog", "//lib/i18n/settings"],
)
rust_test(name = "tests", crate = ":i18n")
