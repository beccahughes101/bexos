load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
package(default_visibility = ["//visibility:public"])
rust_library(
    name = "graphics",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_graphics",
    edition = "2024",
    deps = ["@crates//:vello_cpu", "//lib/migration", "//lib/flatland"],
)
rust_test(
    name = "tests",
    srcs = ["tests/graphics_tests.rs"],
    edition = "2024",
    deps = [":graphics", "//lib/migration"],
)
