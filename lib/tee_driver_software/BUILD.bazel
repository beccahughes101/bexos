load("//build/rules:app_archive.bzl", "app_archive")
load("//build/rules:userspace.bzl", "app_manifest", "std_shared_library")

package(default_visibility = ["//visibility:public"])

std_shared_library(
    name = "tee_driver_software_shared",
    srcs = ["src/shared.rs"],
    crate_root = "src/shared.rs",
    crate_features = ["bexos_libc_runtime"],
    crate_name = "bexos_tee_driver_software",
    soname = "libbexos_tee_driver.so",
    deps = [
        "//lib/tee_driver_client",
    ],
)

app_manifest(name = "package_manifest", src = "package/tee_driver_software.prototxt")

app_archive(
    name = "tee_driver_software_archive",
    manifest = ":package_manifest",
    entries = {"lib/libbexos_tee_driver.so": ":tee_driver_software_shared"},
    compression = "zstd",
)

app_archive(
    name = "replacement_archive",
    manifest = ":package_manifest",
    entries = {"lib/libbexos_tee_driver.so": ":tee_driver_software_shared"},
    compression = "zstd",
)
