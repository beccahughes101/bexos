load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "trusty_client",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_trusty_client",
    edition = "2024",
    deps = [
        "//lib/crypto:crypto_std",
        "//lib/userspace",
        "//third_party/trusty:kmr_wire",
    ],
)

rust_library(
    name = "trusty_client_no_std",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_trusty_client",
    edition = "2024",
    deps = [
        "//lib/crypto",
        "//lib/userspace",
        "//third_party/trusty:kmr_wire",
    ],
)

rust_test(
    name = "trusty_client_tests",
    srcs = glob(["tests/**/*.rs"]),
    crate_name = "trusty_client_tests",
    edition = "2024",
    deps = [":trusty_client", "//third_party/trusty:kmr_wire"],
)
