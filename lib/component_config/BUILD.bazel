load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
package(default_visibility = ["//visibility:public"])
rust_library(
    name = "component_config",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "bexos_component_config",
    edition = "2024",
)

rust_test(
    name = "tests",
    srcs = glob(["tests/**/*.rs"]),
    edition = "2024",
    deps = [":component_config"],
)

