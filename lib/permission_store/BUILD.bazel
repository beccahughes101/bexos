load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "permission_store",
    srcs = ["src/lib.rs"],
    crate_name = "bexos_permission_store",
    edition = "2024",
)

rust_library(
    name = "permission_store_host",
    srcs = ["src/lib.rs"],
    crate_features = ["std", "redb_backend"],
    crate_name = "bexos_permission_store",
    edition = "2024",
    deps = [
        "//lib/redb:redb_host",
        "@crates//:redb",
    ],
)

rust_library(
    name = "permission_store_bexos_std",
    srcs = ["src/lib.rs"],
    crate_features = ["std", "redb_backend"],
    crate_name = "bexos_permission_store",
    edition = "2024",
    deps = [
        "//lib/redb:redb_bexos_std",
        "@crates//:redb",
    ],
)

rust_test(
    name = "permission_store_tests",
    srcs = ["tests/permission_store_tests.rs"],
    crate_name = "permission_store_tests",
    edition = "2024",
    deps = [
        ":permission_store_host",
        "//lib/redb:redb_host",
    ],
)
