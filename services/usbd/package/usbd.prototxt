package_name: "bexos.service.usbd"
name: "usbd"
library_dependencies { package_name: "bexos.lib.crypto" mount_alias: "bexos.lib.crypto" abi_version: 1 }
library_dependencies { package_name: "bexos.lib.net" mount_alias: "bexos.lib.net" abi_version: 1 }
processes {
 name: "usbd"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT preparation_timeout_ms: 30000 }
 service: true
 wave: 2
 runner_options { [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/usbd" } }
}
services_consumed {
 name: "bexos.usb.host.XhciController"
 link_type: OPTIONAL
 capabilities {
  capability: "UsbBusManager"
  methods { ordinal: 1 link_type: OPTIONAL }
  methods { ordinal: 2 link_type: OPTIONAL }
  methods { ordinal: 3 link_type: OPTIONAL }
  methods { ordinal: 4 link_type: OPTIONAL }
  methods { ordinal: 5 link_type: OPTIONAL }
  methods { ordinal: 6 link_type: OPTIONAL }
  methods { ordinal: 7 link_type: OPTIONAL }
  methods { ordinal: 8 link_type: OPTIONAL }
  methods { ordinal: 9 link_type: OPTIONAL }
 }
}
services_consumed {
 name: "bexos.hardware.manager.DeviceRegistry"
 link_type: REQUIRED
 capabilities {
  capability: "UsbDescendantRegistrar"
  methods { ordinal: 1 link_type: REQUIRED }
  methods { ordinal: 2 link_type: REQUIRED }
 }
}
services_exposed {
 name: "bexos.usb.host.UsbBus"
 protocol: "UsbBus"
 lifecycle: SINGLETON
 visibility: PRIVATE
 capabilities {
  capability: "UsbClassPolicy"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
 }
}
