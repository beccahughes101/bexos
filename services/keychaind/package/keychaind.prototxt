package_name: "bexos.service.keychaind"
name: "keychaind"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
permissions {
 name: "TEE_MANAGER_ACCESS"
 requirement: PERMISSION_REQUIRED
 usage_description: "Broker hardware-backed keys through Trusty KeyMint."
}
processes {
 name: "keychaind"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 permissions {
  name: "TEE_MANAGER_ACCESS"
  requirement: PERMISSION_REQUIRED
  usage_description: "Broker hardware-backed keys through Trusty KeyMint."
 }
 wave: 5
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/keychaind" }
 }
}
services_exposed {
 name: "bexos.security.Keychain"
 protocol: "Keychain"
 lifecycle: SINGLETON
 visibility: PUBLIC
 activation: LAZY
 provider_process: "keychaind"
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
  method_ordinals: 5
  method_ordinals: 6
  method_ordinals: 7
 }
}
services_consumed {
 name: "bexos.user.UserManager"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 2 link_type: REQUIRED }
 }
 capabilities {
  capability: "UserAuthBroker"
  methods { ordinal: 9 link_type: REQUIRED }
 }
}
services_consumed {
 name: "bexos.service.vfsd"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 61 link_type: REQUIRED }
  methods { ordinal: 62 link_type: REQUIRED }
 }
}
services_consumed {
 name: "tee_manager"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 5 link_type: REQUIRED }
  methods { ordinal: 6 link_type: REQUIRED }
  methods { ordinal: 7 link_type: REQUIRED }
 }
}
