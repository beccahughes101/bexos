package_name: "bexos.service.prefsd"
name: "User Preferences"
processes {
 name: "prefsd"
 runner: "elf"
 service: true
 wave: 5
 resource_group: "system"
 lifecycle { update_strategy: HEART_TRANSPLANT migration_timeout_ms: 1000 }
 runner_options { [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/prefsd" } }
}
config_schema { fields { name: "prepare_timeout_ms" type: CONFIG_UINT64 default_value { uint64_value: 5000 } uint_range { min: 1 max: 60000 } } }
services_exposed {
 name: "bexos.preferences.UserPreferences"
 protocol: "UserPreferences"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities { capability: "Public" method_ordinals: 1 method_ordinals: 2 method_ordinals: 3 }
 capabilities { capability: "ManageUserPreferences" permission: "bexos.permission.MANAGE_USER_PREFERENCES" method_ordinals: 4 }
}
services_exposed {
 name: "bexos.ui.theme.ThemeManager"
 protocol: "ThemeManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities { capability: "Public" method_ordinals: 1 method_ordinals: 2 }
}
services_consumed { name: "bexos.service.vfsd" link_type: REQUIRED capabilities { capability: "Public" methods { ordinal: 61 link_type: REQUIRED } methods { ordinal: 62 link_type: REQUIRED } } }
services_consumed { name: "bexos.user.UserManager" link_type: REQUIRED capabilities { capability: "Public" methods { ordinal: 1 link_type: REQUIRED } methods { ordinal: 2 link_type: REQUIRED } methods { ordinal: 8 link_type: REQUIRED } } }

services_exposed {
 name: "bexos.locale.LocalePreferences" protocol: "LocalePreferences" lifecycle: SINGLETON visibility: PUBLIC
 capabilities { capability: "LocaleRead" method_ordinals: 1 method_ordinals: 2 }
}
