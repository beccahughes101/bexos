package_name: "bexos.service.timed"
name: "timed"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
permissions {
 name: "SET_TIME"
 requirement: PERMISSION_REQUIRED
 usage_description: "Adjust the system realtime clock after trusted SNTP synchronization."
}
processes {
 name: "timed"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 permissions {
  name: "SET_TIME"
  requirement: PERMISSION_REQUIRED
  usage_description: "Adjust the system realtime clock after trusted SNTP synchronization."
 }
 wave: 6
 resource_group: "system"
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/timed" }
 }
}
config_schema {
 fields {
  name: "primary_server"
  type: CONFIG_STRING
  required: true
  max_size: 128
  default_value { string_value: "time.google.com" }
 }
 fields {
  name: "poll_interval_ms"
  type: CONFIG_UINT32
  default_value { uint32_value: 60000 }
 }
 fields {
  name: "initial_retry_ms"
  type: CONFIG_UINT32
  default_value { uint32_value: 1000 }
 }
 fields {
  name: "use_nts"
  type: CONFIG_BOOL
  default_value { bool_value: false }
 }
 fields {
  name: "slew_limit_ppm"
  type: CONFIG_UINT32
  default_value { uint32_value: 500 }
 }
 fields {
  name: "slew_step_threshold_ns"
  type: CONFIG_UINT64
  default_value { uint64_value: 1000000000 }
 }
}
services_exposed {
 name: "bexos.time.TimeManager"
 protocol: "TimeManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
  method_ordinals: 5
 }
}
services_consumed {
 name: "bexos.net.Netstack"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 1 link_type: REQUIRED }
  methods { ordinal: 3 link_type: REQUIRED }
  methods { ordinal: 4 link_type: REQUIRED }
 }
}
services_consumed {
 name: "bexos.security.trust.TlsTrustManager"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 1 link_type: REQUIRED }
 }
}
services_consumed {
 name: "bexos.kernel.Clock"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 6887237422062436418 link_type: REQUIRED }
 }
}
services_consumed {
 name: "bexos.kernel.SystemPrivileged"
 link_type: REQUIRED
 capabilities {
  capability: "SetTime"
  methods { ordinal: 6855954954352417048 link_type: REQUIRED }
 }
}
services_consumed {
 name: "bexos.time.RtcHardware"
 link_type: OPTIONAL
 capabilities {
  capability: "Public"
  methods { ordinal: 1 link_type: OPTIONAL }
  methods { ordinal: 2 link_type: OPTIONAL }
 }
}
