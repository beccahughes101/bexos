package_name: "bexos.service.splashd"
name: "splashd"
library_dependencies { package_name: "bexos.lib.crypto" mount_alias: "bexos.lib.crypto" abi_version: 1 }
library_dependencies { package_name: "bexos.lib.net" mount_alias: "bexos.lib.net" abi_version: 1 }
processes { name: "splashd" runner: "elf" lifecycle { update_strategy: HEART_TRANSPLANT } service: true wave: 1 runner_options { [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/splashd" } } }
services_exposed { name: "bexos.splash.ProgressTracker" protocol: "ProgressTracker" lifecycle: SINGLETON visibility: PRIVATE capabilities { capability: "Public" method_ordinals: 1 method_ordinals: 2 } }
services_consumed { name: "bexos.hardware.display.DisplayCoordinator" link_type: OPTIONAL capabilities { capability: "Public" methods { ordinal: 1 link_type: OPTIONAL } methods { ordinal: 2 link_type: OPTIONAL } methods { ordinal: 3 link_type: OPTIONAL } methods { ordinal: 4 link_type: OPTIONAL } methods { ordinal: 5 link_type: OPTIONAL } methods { ordinal: 6 link_type: OPTIONAL } } }
permissions { name: "bexos.permission.REALTIME_SCHEDULING" usage_description: "Pace boot display frames with bounded deadline scheduling." }
