package_name: "bexos.service.usersd"
name: "usersd"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
permissions {
 name: "TEE_MANAGER_ACCESS"
 requirement: PERMISSION_REQUIRED
 usage_description: "Enroll and verify users with Trusty Gatekeeper and derive auth-bound filesystem keys through KeyMint."
}
processes {
 name: "usersd"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 4
 resource_group: "system"
 permissions {
  name: "TEE_MANAGER_ACCESS"
  requirement: PERMISSION_REQUIRED
  usage_description: "Enroll and verify users with Trusty Gatekeeper and derive auth-bound filesystem keys through KeyMint."
 }
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/usersd" }
 }
}
services_exposed {
 name: "bexos.user.UserManager"
 protocol: "UserManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
  method_ordinals: 5
  method_ordinals: 6
  method_ordinals: 7
  method_ordinals: 8
 }
 capabilities {
  capability: "UserAuthBroker"
  method_ordinals: 9
 }
}
services_consumed {
 name: "bexos.service.vfsd"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 57 link_type: REQUIRED }
  methods { ordinal: 58 link_type: REQUIRED }
  methods { ordinal: 59 link_type: REQUIRED }
  methods { ordinal: 60 link_type: REQUIRED }
  methods { ordinal: 61 link_type: REQUIRED }
 }
}
services_consumed {
 name: "tee_manager"
 link_type: REQUIRED
 capabilities {
  capability: "Public"
  methods { ordinal: 5 link_type: REQUIRED }
  methods { ordinal: 6 link_type: REQUIRED }
  methods { ordinal: 7 link_type: REQUIRED }
 }
}
