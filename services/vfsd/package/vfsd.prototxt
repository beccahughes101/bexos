package_name: "bexos.service.vfsd"
name: "vfsd"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
processes {
 name: "vfsd"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 3
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/vfsd" }
 }
}
services_exposed {
 name: "bexos.service.vfsd"
 protocol: "VfsManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 50
  method_ordinals: 51
  method_ordinals: 52
  method_ordinals: 53
  method_ordinals: 54
  method_ordinals: 55
  method_ordinals: 56
  method_ordinals: 57
  method_ordinals: 58
  method_ordinals: 59
  method_ordinals: 60
  method_ordinals: 61
  method_ordinals: 62
  method_ordinals: 63
  method_ordinals: 64
  method_ordinals: 65
  method_ordinals: 66
 }
}
