package_name: "bexos.service.trustd"
name: "trustd"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
processes {
 name: "trustd"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 3
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/trustd" }
 }
}
services_exposed {
 name: "bexos.security.trust.AppTrustManager"
 protocol: "AppTrustManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
 }
 capabilities {
  capability: "SYSTEM_PRIVILEGED"
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
  method_ordinals: 5
 }
}
services_exposed {
 name: "bexos.security.trust.TlsTrustManager"
 protocol: "TlsTrustManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
 }
}
