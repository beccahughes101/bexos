package_name: "bexos.service.updated"
name: "updated"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
permissions {
 name: "PLATFORM_UPDATE"
 requirement: PERMISSION_REQUIRED
 usage_description: "Apply verified platform update artifacts."
}
permissions {
 name: "TEE_MANAGER_ACCESS"
 requirement: PERMISSION_REQUIRED
 usage_description: "Coordinate verified Trusty core lifecycle operations through teed."
}
processes {
 name: "updated"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 permissions {
  name: "PLATFORM_UPDATE"
  requirement: PERMISSION_REQUIRED
  usage_description: "Apply verified platform update artifacts."
 }
 permissions {
  name: "TEE_MANAGER_ACCESS"
  requirement: PERMISSION_REQUIRED
  usage_description: "Coordinate verified Trusty core lifecycle operations through teed."
 }
 wave: 3
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/updated" }
 }
}
services_exposed {
 name: "bexos.update.UpdateManager"
 protocol: "UpdateManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
  method_ordinals: 5
  method_ordinals: 6
  method_ordinals: 7
  method_ordinals: 8
  method_ordinals: 9
  method_ordinals: 10
  method_ordinals: 11
  method_ordinals: 12
 }
}
services_consumed {
 name: "tee_manager"
 link_type: OPTIONAL
 capabilities {
  capability: "Public"
  methods { ordinal: 8 link_type: OPTIONAL }
  methods { ordinal: 9 link_type: OPTIONAL }
 }
}
