package_name: "bexos.service.powerd"
name: "powerd"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
permissions {
 name: "BEXOS_SYSTEM_PRIVILEGED"
 usage_description: "Request privileged kernel power operations."
}
processes {
 name: "powerd"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 4
 resource_group: "system"
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/powerd" }
 }
}
services_exposed {
 name: "bexos.power.PowerManager"
 protocol: "PowerManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
 }
}
services_consumed {
 name: "bexos.kernel.SystemPrivileged"
 link_type: REQUIRED
 capabilities {
  capability: "BexosSystemPrivileged"
  methods { ordinal: 962740459103016760 link_type: REQUIRED }
  methods { ordinal: 4930477852564617786 link_type: REQUIRED }
  methods { ordinal: 5089370860268945714 link_type: REQUIRED }
  methods { ordinal: 6711119950886114089 link_type: REQUIRED }
 }
}
services_consumed {
 name: "bexos.power.DevicePowerControl"
 link_type: OPTIONAL
 capabilities {
  capability: "Public"
  methods { ordinal: 1 link_type: OPTIONAL }
 }
}
services_consumed {
 name: "bexos.power.PowerTelemetry"
 link_type: OPTIONAL
 capabilities {
  capability: "Public"
  methods { ordinal: 1 link_type: OPTIONAL }
 }
}
services_consumed {
 name: "bexos.power.PerformanceControl"
 link_type: OPTIONAL
 capabilities {
  capability: "Public"
  methods { ordinal: 1 link_type: OPTIONAL }
 }
}
