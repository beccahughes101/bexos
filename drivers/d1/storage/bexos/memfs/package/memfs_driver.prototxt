package_name: "bexos.driver.storage.memfs"
name: "memfs_driver"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
processes {
 name: "memfs_driver"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 2
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/memfs_driver" }
 }
}
services_exposed {
 name: "bexos.storage.memfs.MemfsManager"
 protocol: "MemfsManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 70
 }
}
