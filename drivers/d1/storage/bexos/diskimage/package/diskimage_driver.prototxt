package_name: "bexos.driver.storage.diskimage"
name: "diskimage_driver"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
driver_info {
 name: "diskimage_d1_driver"
 package_id: "bexos.driver.storage.diskimage"
 version: "1.0.0"
}
processes {
 name: "diskimage_driver"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 3
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/diskimage_driver" }
 }
}
services_exposed {
 name: "bexos.storage.diskimage.DiskImageManager"
 protocol: "DiskImageManager"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
 }
}
