package_name: "bexos.driver.storage.nvme"
name: "nvme_driver"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
driver_info {
 name: "nvme_d1_driver"
 package_id: "bexos.driver.storage.nvme"
 version: "1.0.0"
 execution { colocation_policy: DRIVER_ISOLATED max_instances_per_host: 1 restart_strategy: DRIVER_HEART_TRANSPLANT }
 required_resources { kind: DRIVER_RESOURCE_MMIO min_count: 1 }
 required_resources { kind: DRIVER_RESOURCE_INTERRUPT min_count: 1 }
 required_resources { kind: DRIVER_RESOURCE_IOMMU_DOMAIN min_count: 1 }
 required_resources { kind: DRIVER_RESOURCE_BUS_CONTROL min_count: 1 }
}
bind_rules {
 condition {
  bus: BUS_PCI
  property { key: "pci.class" value: 0x01 }
  property { key: "pci.subclass" value: 0x08 }
  property { key: "pci.prog_if" value: 0x02 }
 }
}
processes {
 name: "nvme_driver"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 1
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/nvme_driver" }
 }
}
services_exposed {
 name: "bexos.storage.block.BlockDevice"
 protocol: "BlockDevice"
 lifecycle: MULTIPLE_INSTANCE
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
  method_ordinals: 3
  method_ordinals: 4
  method_ordinals: 5
 }
}
services_exposed {
 name: "bexos.power.DevicePowerControl"
 protocol: "DevicePowerControl"
 lifecycle: MULTIPLE_INSTANCE
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
 }
}
