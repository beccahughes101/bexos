package_name: "bexos.driver.display.virtio_gpu"
name: "gpu"
library_dependencies { package_name: "bexos.lib.crypto" mount_alias: "bexos.lib.crypto" abi_version: 1 }
library_dependencies { package_name: "bexos.lib.net" mount_alias: "bexos.lib.net" abi_version: 1 }
driver_info { name: "virtio_gpu_d1_driver" package_id: "bexos.driver.display.virtio_gpu" version: "1.0.0" }
bind_rules { priority: 20 condition { bus: BUS_PCI property { key: "pci.vendor_id" value: 0x1af4 } property { key: "pci.device_id" value: 0x1050 } } }
processes { name: "gpu" runner: "elf" lifecycle { update_strategy: HEART_TRANSPLANT } service: true wave: 1 runner_options { [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/gpu" } } }
services_exposed { name: "bexos.hardware.display.DisplayCoordinator" protocol: "DisplayCoordinator" lifecycle: SINGLETON visibility: PRIVATE capabilities { capability: "Public" method_ordinals: 1 method_ordinals: 2 method_ordinals: 3 method_ordinals: 4 method_ordinals: 5 method_ordinals: 6 method_ordinals: 7 method_ordinals: 8 method_ordinals: 9 method_ordinals: 16 method_ordinals: 17 method_ordinals: 18 method_ordinals: 19 } capabilities { capability: "GpuTransport" method_ordinals: 7 method_ordinals: 8 method_ordinals: 9 method_ordinals: 10 method_ordinals: 11 method_ordinals: 12 method_ordinals: 13 method_ordinals: 14 method_ordinals: 15 } }
