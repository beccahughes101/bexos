package_name: "bexos.driver.serial.virtio_console"
name: "virtio_console_driver"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
driver_info {
 name: "virtio_console_d1_driver"
 package_id: "bexos.driver.serial.virtio_console"
 version: "1.0.0"
}
bind_rules {
 condition {
  bus: BUS_PCI
  property { key: "pci.vendor_id" value: 0x1af4 }
  property { key: "pci.device_id" value: 0x1043 }
 }
}
processes {
 name: "virtio_console_driver"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 1
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/virtio_console_driver" }
 }
}
