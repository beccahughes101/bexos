package_name: "bexos.driver.uart.pl011"
name: "pl011"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
processes {
 name: "pl011"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 0
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/pl011" }
 }
}
services_exposed {
 name: "bexos.power.DevicePowerControl"
 protocol: "DevicePowerControl"
 lifecycle: MULTIPLE_INSTANCE
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
 }
}
