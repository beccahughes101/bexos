package_name: "bexos.driver.input.virtio"
name: "input"
library_dependencies { package_name: "bexos.lib.crypto" mount_alias: "bexos.lib.crypto" abi_version: 1 }
library_dependencies { package_name: "bexos.lib.net" mount_alias: "bexos.lib.net" abi_version: 1 }
driver_info { name: "virtio_input_d1_driver" package_id: "bexos.driver.input.virtio" version: "1.0.0" }
bind_rules { priority: 20 condition { bus: BUS_PCI property { key: "pci.vendor_id" value: 0x1af4 } property { key: "pci.device_id" value: 0x1052 } } }
processes { name: "input" runner: "elf" lifecycle { update_strategy: HEART_TRANSPLANT } service: true wave: 1 runner_options { [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/input" } } }
services_exposed { name: "bexos.hardware.input.InputDevice" protocol: "InputDevice" lifecycle: MULTIPLE_INSTANCE visibility: PRIVATE capabilities { capability: "Public" method_ordinals: 1 } }
