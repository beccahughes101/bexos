package_name: "bexos.driver.rtc.pl031"
name: "pl031"
library_dependencies {
 package_name: "bexos.lib.crypto"
 mount_alias: "bexos.lib.crypto"
 abi_version: 1
}
library_dependencies {
 package_name: "bexos.lib.net"
 mount_alias: "bexos.lib.net"
 abi_version: 1
}
processes {
 name: "pl031"
 runner: "elf"
 lifecycle { update_strategy: HEART_TRANSPLANT }
 service: true
 wave: 0
 runner_options {
  [type.googleapis.com/bexos.app.ELFRunnerOptions] { path: "/pkg/bin/pl031" }
 }
}
services_exposed {
 name: "bexos.time.RtcHardware"
 protocol: "RtcHardware"
 lifecycle: SINGLETON
 visibility: PUBLIC
 capabilities {
  capability: "Public"
  method_ordinals: 1
  method_ordinals: 2
 }
}
